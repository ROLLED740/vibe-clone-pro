# Copy to .env.local and fill in. Nothing here is secret — real values are.

# ---------- Core ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Postgres connection string (Neon, Supabase, or any Postgres).
DATABASE_URL=

# ---------- Auth (Clerk) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- Billing (Stripe) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs per plan. Checkout resolves these server-side from lib/plans.ts —
# a plan with no configured price ID reports as unavailable rather than
# charging the wrong amount. Yearly falls back to monthly when unset.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=

# ---------- Media generation ----------
# With no FAL_KEY the app runs on the stub provider: the full loop (queue,
# poll, spend, refund, gallery) works and returns placeholder media, so you
# can develop without spending. Set MEDIA_PROVIDER=stub to force that on.
FAL_KEY=
MEDIA_PROVIDER=
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video
