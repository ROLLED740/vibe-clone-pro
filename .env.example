# Copy to .env.local and fill in. Nothing here is secret — real values are.

# ---------- Core ----------
# Public origin, used for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Neon Postgres connection string (see NEON_SETUP.md).
DATABASE_URL=

# ---------- Auth (Clerk) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- Billing (Stripe) ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs per plan. Checkout resolves these server-side from lib/plans.ts —
# a plan with no configured price ID is reported as unavailable rather than
# charging the wrong amount. Yearly falls back to monthly when unset.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_LIFETIME=

# ---------- AI providers ----------
# At least one is required. Anthropic is the primary generator; the others are
# fallbacks. A Gemini key is additionally required for image-based builds.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults live in lib/models.ts).
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash
# XAI_MODEL=grok-2-latest

# ---------- Background jobs (Inngest) ----------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------- Kill switch ----------
# Rewrites all traffic to /maintenance. Also readable from Vercel Edge Config.
EMERGENCY_KILL_SWITCH=false
EDGE_CONFIG=
