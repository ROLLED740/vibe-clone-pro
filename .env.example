# Copy to .env.local and fill in. Nothing here is secret — real values are.

# ---------- Core ----------
# Public origin, used for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Neon Postgres connection string (see NEON_SETUP.md).
DATABASE_URL=

# ---------- Auth (Clerk) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- Billing (Stripe) ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# The two products have separate Stripe prices and never share one. Checkout
# resolves these server-side; a plan with no configured price ID reports as
# unavailable rather than charging the wrong amount. Yearly falls back to
# monthly when unset.

# VibeClonePro — the app generator (lib/plans.ts), served at /pricing.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_LIFETIME=

# VibeClips — the clip studio (lib/clips/plans.ts), served at /clips/pricing.
STRIPE_PRICE_CLIPS_STARTER_MONTHLY=
STRIPE_PRICE_CLIPS_STARTER_YEARLY=
STRIPE_PRICE_CLIPS_PRO_MONTHLY=
STRIPE_PRICE_CLIPS_PRO_YEARLY=
STRIPE_PRICE_CLIPS_ULTRA_MONTHLY=
STRIPE_PRICE_CLIPS_ULTRA_YEARLY=

# ---------- Media generation (VibeClips) ----------
# Without FAL_KEY the studio runs on the stub provider: the full loop (queue,
# poll, credits, gallery) works and returns placeholder media, so you can
# develop without spending. Set MEDIA_PROVIDER=stub to force that on.
FAL_KEY=
MEDIA_PROVIDER=
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video

# ---------- AI providers ----------
# At least one is required. Anthropic is the primary generator; the others are
# fallbacks. A Gemini key is additionally required for image-based builds.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults live in lib/models.ts).
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash
# XAI_MODEL=grok-2-latest

# ---------- Background jobs (Inngest) ----------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------- Kill switch ----------
# Rewrites all traffic to /maintenance. Also readable from Vercel Edge Config.
EMERGENCY_KILL_SWITCH=false
EDGE_CONFIG=
